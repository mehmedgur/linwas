<?xml version="1.0" encoding="UTF-8"?>
<!--
  linwas-office-look varsayılanları. Kullanıcının kendi profilindeki ayarlar
  (Linwas "Office görünümü" sayfası, linwas-office-look aracı) bu değerlerin
  önüne geçer. Sade şeridi etkinleştiren parça kurulumda üretilir:
  linwas-office-look-ribbon.xcd.

  writer/calc/impress.xcd kendi Factories varsayılanlarını yazdığı için bu
  dosyanın onlardan sonra yüklenmesi gerekir. Bağımlılık dosyalarından biri
  yoksa LibreOffice bu dosyayı hiç yüklemez; paket bu yüzden üç uygulamaya da
  bağımlıdır.

  Var olan set düğümlerinde oor:op="replace" kullanılmaz: düğümün diğer
  alanlarını siler.
-->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
  <dependency file="main"/>
  <dependency file="writer"/>
  <dependency file="calc"/>
  <dependency file="impress"/>


  <!-- Varsayılan kayıt biçimi: Office Open XML. -->
  <oor:component-data oor:name="Setup" oor:package="org.openoffice">
    <node oor:name="Office">
      <node oor:name="Factories">
        <node oor:name="com.sun.star.text.TextDocument">
          <prop oor:name="ooSetupFactoryDefaultFilter" oor:op="fuse">
            <value>MS Word 2007 XML</value>
          </prop>
        </node>
        <node oor:name="com.sun.star.sheet.SpreadsheetDocument">
          <prop oor:name="ooSetupFactoryDefaultFilter" oor:op="fuse">
            <value>Calc MS Excel 2007 XML</value>
          </prop>
        </node>
        <node oor:name="com.sun.star.presentation.PresentationDocument">
          <prop oor:name="ooSetupFactoryDefaultFilter" oor:op="fuse">
            <value>Impress MS PowerPoint 2007 XML</value>
          </prop>
        </node>
      </node>
    </node>
  </oor:component-data>

  <!-- Varsayılan biçim zaten OOXML olduğundan her kayıtta "biçimi koru" sorusu sorulmaz. -->
  <oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
    <node oor:name="Save">
      <node oor:name="Document">
        <prop oor:name="WarnAlienFormat" oor:op="fuse">
          <value>false</value>
        </prop>
      </node>
    </node>
  </oor:component-data>

  <!-- Impress açılışta "Şablon Seç" penceresini göstermez; boş sunumla başlar. -->
  <oor:component-data oor:name="Impress" oor:package="org.openoffice.Office">
    <node oor:name="Misc">
      <node oor:name="NewDoc">
        <prop oor:name="AutoPilot" oor:op="fuse">
          <value>false</value>
        </prop>
      </node>
    </node>
  </oor:component-data>

  <!-- Calc formül yazımı Excel A1: başka sayfaya başvuru Excel'deki gibi Sayfa1!A1 (Calc'ta
       Sayfa1.A1). 0 = Calc A1, 1 = Excel A1, 2 = Excel R1C1 (Araçlar › Seçenekler › Calc ›
       Formül). Dosya biçimini değil yalnız formül yazıp okumayı etkiler. -->
  <oor:component-data oor:name="Calc" oor:package="org.openoffice.Office">
    <node oor:name="Formula">
      <node oor:name="Syntax">
        <prop oor:name="Grammar" oor:op="fuse">
          <value>1</value>
        </prop>
      </node>
    </node>
  </oor:component-data>
  <!-- Writer temel yazı tipleri: Calibri ile metrik uyumlu Carlito, gövde 11 pt (1/100 mm). -->
  <oor:component-data oor:name="Writer" oor:package="org.openoffice.Office">
    <node oor:name="DefaultFont">
      <prop oor:name="Standard" oor:op="fuse">
        <value>Carlito</value>
      </prop>
      <prop oor:name="StandardHeight" oor:op="fuse">
        <value>388</value>
      </prop>
      <prop oor:name="Heading" oor:op="fuse">
        <value>Carlito</value>
      </prop>
      <prop oor:name="List" oor:op="fuse">
        <value>Carlito</value>
      </prop>
      <prop oor:name="Caption" oor:op="fuse">
        <value>Carlito</value>
      </prop>
      <prop oor:name="Index" oor:op="fuse">
        <value>Carlito</value>
      </prop>
    </node>
  </oor:component-data>
</oor:data>
