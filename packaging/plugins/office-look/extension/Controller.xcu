<?xml version="1.0" encoding="UTF-8"?>
<!-- Sade şeridin Dosya sekmesindeki öğe: sekme açılınca Dosya menüsünü gösteren denetçi. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" oor:name="Controller" oor:package="org.openoffice.Office.UI">
  <node oor:name="Registered">
    <node oor:name="ToolBar">
      <node oor:name="LinwasFileTab" oor:op="replace">
        <prop oor:name="Command">
          <value>.uno:LinwasFileTab</value>
        </prop>
        <prop oor:name="Module">
          <value/>
        </prop>
        <prop oor:name="Controller">
          <value>org.linwas.officelook.FileTabController</value>
        </prop>
      </node>
    </node>
  </node>
</oor:component-data>
